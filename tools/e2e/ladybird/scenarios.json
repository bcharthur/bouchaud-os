      "etapes": [
        {"attend": "BOUCHAUD_CPU_ISA hyperviseur=", "delai_s": 240, "nom": "noyau"},
        {"attend": "SMP_NG2_SCHEDULER online=", "delai_s": 240, "nom": "ordonnanceur"},
        {"attend": "BOUCHAUD_SMP_BATTEMENT_BILAN battants=", "delai_s": 240, "nom": "battement"},
        {"attend": "BOUCHAUD_ATELIER_DEMARRER fenetres=0 ", "delai_s": 420, "nom": "bureau"},
        {"capture": "01-bureau"}
      ],
      "metriques": [
