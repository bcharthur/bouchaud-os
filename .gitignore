/target/
# Cette sonde est une application Rust autonome. Cargo regenere son verrou a
# chaque build; seule la chaine principale verrouille ses dependances ici.
tools/python-wasm/Cargo.lock
tools/python-wasm/target/
.idea/
*.iml
.DS_Store
*.pdb
# Local QEMU/session logs
session.log
*.log

# Dependances npm du service de rendu deporte (tools/render-proxy)
node_modules/
tools/render-proxy/node_modules/

# Binaires userland compiles (build.sh) et image du disque de donnees (mkdisk.sh)
tools/userland/out/
tools/userland/*.img
# Le manifeste voyage avec l'image : construit par build-tout.sh, ou telecharge
# par tools/userland.ps1. Ni l'un ni l'autre n'a sa place dans le depot — c'est
# la release qui en est la reference.
tools/userland/userland-manifest.json
# Artefacts du lanceur de sondes (tools/test.sh)
tools/userland/test-out/
# Sondes compilees par `OUT=out-sondes ./build.sh musl`, ce que fait le workflow
# os-primitives et ce qu'on refait a la main pour reproduire un defaut. Meme
# nature que `out/` juste au-dessus : des binaires regenerables.
tools/userland/out-sondes/
# Chantiers et resultats de build-python.sh / build-qt.sh (sources telechargees,
# arbres de compilation, binaires produits)
tools/userland/build-python-musl/
tools/userland/build-python-glibc/
tools/userland/build-qt/
tools/userland/out-python/
tools/userland/out-qt/
tools/userland/build-navigateur/
tools/userland/out-navigateur/
tools/userland/out-python-embed/
tools/userland/build-quickjs/
tools/userland/out-quickjs/
tools/userland/build-ffmpeg/
tools/userland/out-ffmpeg/
# Bac a sable glibc de build-abi-linux.sh : la sonde compilee et une copie des
# bibliotheques de l'hote. Rien de tout cela n'a sa place dans le depot.
tools/userland/out-abi-linux/
# Copie de travail de test-moteur.sh (le moteur y est recopie avant execution)
tools/userland/build-test-moteur/

# Bytecode Python
__pycache__/
*.pyc
# Banc de verification de l'hote Qt (verifie-hote.sh)
tools/userland/build-verifie-hote/

# Fichier de travail du tableau de bord, efface a la fin de chaque execution.
tools/userland/navigateur/.suivi-observations.jsonl

# Rapport de la sonde d'ordonnancement : ses chiffres sont ceux de la machine
# qui l'a lancee, pas ceux du projet. Le versionner ferait passer la latence
# d'un poste de developpement a plusieurs cœurs pour une propriete de l'OS.
# `audit-privileges.json`, lui, est versionne : il porte des capacites, pas des
# millisecondes.
tools/userland/navigateur/tests/ordonnanceur-navigateur.json

# Verdict du demarrage produit, ecrit par tools/verdict-produit.py a chaque
# execution. Un resultat de mesure, pas une source.
jalons-produit.json

# Arbre Ladybird : recupere par tools/ladybird/fetch.sh au SHA de
# third_party/UPSTREAM.md. 27 877 fichiers qui n' ont rien a faire dans
# l' historique de Bouchaud.
third_party/ladybird/

# Constructions du portage Ladybird (regenerables par tools/ladybird/*.sh)
third_party/deps-src/
third_party/deps-hote/
third_party/deps-bouchaud/
third_party/build-ak-*/
third_party/build-libcore-*/
third_party/build-libgc-*/
third_party/build-libunicode-*/
third_party/build-rust-*/
third_party/icu-src/
third_party/icu-hote/
third_party/icu-bouchaud/
# Les variantes « cible » sont des liens symboliques vers la construction hote
# (meme chaine d'outils, voir build-icu.sh) : les motifs a barre oblique
# ci-dessus ne les attrapent pas.
third_party/icu-bouchaud
third_party/build-rust-bouchaud
third_party/build-libcrypto-*/
third_party/build-libjs-*/
third_party/gen-hote/
third_party/gen-bouchaud/
third_party/gen-bouchaud
third_party/build-js-*/
third_party/build-libipc-*/
third_party/build-libtest-*/
third_party/build-libipc-*/

# Chantiers vcpkg du portage graphique (regenerables par build-vcpkg-gfx.sh)
third_party/vcpkg-gfx/
third_party/vcpkg-gfx-installed/
third_party/vcpkg-gfx-manifest/
third_party/vcpkg-downloads/
third_party/build-libgfx-*/
third_party/build-libcompress-*/
third_party/build-rust-gfx-*/
third_party/gen-libweb/
third_party/build-libweb-*/
third_party/build-webcontent-*/
third_party/vcpkg-browser-manifest/
third_party/vcpkg-browser-installed/
third_party/ladybird-browser-src/
third_party/build-ladybird-browser-bouchaud/
third_party/native-browser-bouchaud/

# Magasin d'autorites fabrique par tools/ladybird/certs/fabrique-bundle.ps1.
# Il decrit la confiance de LA machine qui l'a produit : le versionner
# diffuserait une decision de confiance, et la diffuserait perimee.
tools/ladybird/certs/cacert.pem


